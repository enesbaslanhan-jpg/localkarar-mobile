<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.localkarar.app">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cevrimdisi bandi icin ag durumunu okuma. Konum ya da kimlik bilgisi
         tasimayan "normal" seviyede bir izin; kullaniciya sorulmuyor. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      android:usesCleartextTraffic KALDIRILDI.

      Manifest "true" diyordu, network_security_config.xml ise
      cleartextTrafficPermitted="false" + yalniz 10.0.2.2/localhost istisnasi.
      API 24+ ta ag guvenlik yapilandirmasi kazandigi icin davranis dogruydu
      ama beyan CELISKILIYDI ve magaza taramalari bunu isaretliyor.

      Debug istisnalari artik src/debug/AndroidManifest.xml uzerinden yalniz
      debug derlemesine giriyor; ONCEDEN AYNI MANIFEST RELEASE'E DE GIDIYORDU.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="LocalKarar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalKarar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalKarar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              HTTPS App Links.

              ⚠️ autoVerify="true" ancak sunucuda
              https://localkarar.com/.well-known/assetlinks.json yayindaysa
              calisir ve o dosya RELEASE IMZASININ SHA-256 parmak izini
              icermek zorundadir. Dosya yayina alinana kadar baglantilar
              "dogrulanmamis" sayilir: kullaniciya uygulama/tarayici secimi
              sorulur ama baglanti yine de hedefe gider.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="localkarar.com"
                    android:pathPrefix="/app" />
                <!--
                  EKIP DAVETI — `/app/` disindaki TEK yol.

                  🔴 Bu satir olmadan davet baglantisi uygulamaya HIC
                  ULASMIYORDU: e-posta `https://localkarar.com/davet?token=...`
                  gonderiyor (`mail-templates.ts:182`), suzgec yalniz `/app`
                  taniyordu, baglanti tarayiciya dusuyordu.

                  `pathPrefix` DEGIL `path`: yalnizca tam olarak `/davet`
                  esleniyor. Onek kullanmak `/davetiye-kampanyasi` gibi
                  ileride acilabilecek her sayfayi da uygulamaya cekerdi.
                -->
                <data
                    android:scheme="https"
                    android:host="localkarar.com"
                    android:path="/davet" />
            </intent-filter>
        </activity>

        <!--
          Kamerayla cekilen belgenin sistem kamerasina verilecegi adres.
          `grantUriPermissions` ile izin YALNIZ o tek dosya icin ve
          yalnizca cekim suresince veriliyor.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
