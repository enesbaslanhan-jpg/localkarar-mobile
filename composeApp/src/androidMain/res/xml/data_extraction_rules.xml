<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) yedekleme/aktarim kurallari.

  🔴 `secure_prefs` YEDEGE GIRMEMELI.

  Icerigi Android Keystore ile sifreli ve anahtar CIHAZA BAGLI: yedekle
  birlikte disari cikmiyor. Dolayisiyla dosya baska bir cihaza (ya da
  fabrika ayarlari sonrasi ayni cihaza) geri yuklendiginde COZULEMEZ hale
  geliyor ve EncryptedSharedPreferences.create firlatiyordu.

  Yani bu dosya olmadigi icin, "guvenlik" ozelligi acilista cokme sebebine
  donusuyordu. Depoyu yedekten cikarmak hem o cokmeyi hem de token'in
  cihaz disina tasinmasi ihtimalini ortadan kaldiriyor.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="secure_prefs_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="secure_prefs_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
