<?xml version="1.0" encoding="utf-8"?>
<!--
  🔴 UYGULAMANIN SIMGESI YOKTU.

  Manifest dogrudan `@drawable/local_karar_mark` gosteriyordu. Android 8'den
  beri launcher UYARLANABILIR simge bekliyor; duz bir bitmap verilince
  sistem onu beyaz bir yuvarlak kare rozetin ICINE kucultuyor. Ekranda
  "etrafi mavi cizgili, gerisi beyaz, ortasinda kucuk bir kare" olarak
  goruluyordu; kullanicinin bildirdigi kusur budur.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
