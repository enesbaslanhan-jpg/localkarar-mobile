<?xml version="1.0" encoding="utf-8"?>
<!--
  ACILIS PENCERESI.

  🔴 ONCEDEN DUZ BIR ZEMIN RENGIYDI: uygulama markasiz, bos bir kareyle
  aciliyordu. Artik marka gradyani + marka isareti; Compose'un ilk cizdigi
  kare de (LkAcilisEkrani) ayni gradyan, bu yuzden gecis gorunmuyor.

  ⚠️ Gradyan gece/gunduz DEGISMIYOR — marka isaretinin renkleri temayla
  donmez (devir belgesi §3.5).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF1B3D4C"
                android:endColor="#FF306D88"
                android:angle="315" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/acilis_pusula"
        android:gravity="center"
        android:width="180dp"
        android:height="180dp" />
</layer-list>
